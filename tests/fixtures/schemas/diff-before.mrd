schema catalog v1

table users {
  id          uuid        primary key
  email       text        not null unique
  display     text?       default "anonymous"
  rank        int?
}

table posts {
  id        uuid    primary key
  author    uuid    not null references users.id on delete cascade
  title     text    not null
  body      text?
  views     int?
  index (author, title) unique
}

table legacy_tokens {
  id      uuid    primary key
  token   text    not null
}
